{
    "mcpServers": {
        "playwright": {
            "command": "npx",
            "args": [
                "playwright-mcp"
            ],
            "env": {
                "PLAYWRIGHT_HEADLESS": "false",
                "PLAYWRIGHT_TIMEOUT": "30000"
            }
        }
    },
    "testFramework": "playwright",
    "selfHealing": {
        "enabled": true,
        "strategies": [
            "text-based",
            "data-attributes",
            "css-selectors",
            "xpath"
        ]
    }
}